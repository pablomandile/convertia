# Copiar a .env (desarrollo, con Supabase local) y a .env.production (build de producción).
# La URL y la clave publicable de Supabase son públicas por diseño: la seguridad está en las políticas RLS.
NUXT_PUBLIC_SUPABASE_URL=https://<proyecto>.supabase.co
NUXT_PUBLIC_SUPABASE_KEY=sb_publishable_...
